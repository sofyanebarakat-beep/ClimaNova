# Admin area: PHP login, never indexed, never cached, no directory listing.
DirectoryIndex index.php
Options -Indexes
Header always set X-Robots-Tag "noindex, nofollow"
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "same-origin"
Header always set Cache-Control "no-store"

# Configuration and helpers are included by PHP only, never served.
RewriteEngine On
RewriteRule ^_inc(/|$) - [F,L]

# Clean URLs for the SEO agent: /admin/seo, /admin/seo-offers, … → the matching .php file
RewriteRule ^(seo(-[a-z-]+)?)/?$ $1.php [L]
